<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_ticket_item">

    <!-- Título -->
    <TextView
        android:id="@+id/settings_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/manrope_extrabold"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:text="@string/settings_title" />

    <!-- URL del servidor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/server_label"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/settings_server_url"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:autofillHints="url"
        android:inputType="textUri"
        android:maxLines="1"
        android:hint="@string/url_example"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_chain"
        android:drawableTint="@color/icon_tint"
        android:drawablePadding="8dp"
        android:textSize="14sp" />

    <!-- Nombre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/name_label"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/settings_name"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:hint="@string/name_example"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_person"
        android:drawableTint="@color/icon_tint"
        android:drawablePadding="8dp"
        android:textSize="14sp" />

    <!-- Correo electrónico: siempre deshabilitado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/mail_label"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/settings_mail"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:enabled="false"
        android:focusable="false"
        android:clickable="false"
        android:cursorVisible="false"
        android:importantForAutofill="no"
        android:inputType="none"
        android:maxLines="1"
        android:textColor="@color/text_muted"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_mail"
        android:drawableTint="@color/icon_tint"
        android:drawablePadding="8dp"
        android:textSize="14sp"
        tools:text="tu.correo@ejemplo.com" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/settings_cancel_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_secondary_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:fontFamily="@font/manrope_extrabold"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_save_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/ripple_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/settings_save_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:fontFamily="@font/manrope_extrabold"
                android:textSize="14sp"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
