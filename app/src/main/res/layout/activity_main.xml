<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="28dp"
    android:paddingVertical="32dp"
    tools:context=".MainActivity"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:padding="20dp"
        android:elevation="10dp"
        android:src="@drawable/network_icon"
        android:background="@drawable/rounded_background"
        android:contentDescription="@string/network_icon"
        app:tint="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/start_title"
        android:textSize="20sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="#212121" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/start_subtitle"
        android:textSize="14sp"
        android:fontFamily="@font/manrope_variable"
        android:textStyle="bold"
        android:textColor="#757575"
        android:gravity="center" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/serverUrlLabel"
            android:labelFor="@id/serverUrlInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_label"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mandatory_field"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#F44336" />

    </LinearLayout>

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="url"
        android:inputType="textUri" />

</LinearLayout >