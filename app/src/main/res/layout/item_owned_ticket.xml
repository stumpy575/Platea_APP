<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_event_item"
    android:elevation="2dp">

    <!-- Imagen del evento -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:background="@drawable/bg_event_image"
        android:contentDescription="@string/show_img" />

    <!-- Información del evento -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Título -->
        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_variable"
            android:textStyle="bold"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="[No title]" />

        <!-- Fecha -->
        <TextView
            android:id="@+id/event_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_variable"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#FE6252"
            tools:text="---" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Tipo"
            android:fontFamily="@font/manrope_variable"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#999999" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/code_button"
        android:fontFamily="@font/manrope_variable"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_event_button" />

</LinearLayout>