<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="28dp"
    android:paddingVertical="32dp"
    tools:context=".AuthActivity"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:padding="20dp"
        android:elevation="10dp"
        android:src="@drawable/ic_network"
        android:background="@drawable/bg_icon"
        android:contentDescription="@string/network_icon"
        app:tint="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/start_title"
        android:textSize="22sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="#212121" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/start_subtitle"
        android:textSize="16sp"
        android:fontFamily="@font/manrope_variable"
        android:textStyle="bold"
        android:textColor="#757575"
        android:gravity="center" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- URL del Servidor field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_label"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mandatory_field"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#F44336" />

    </LinearLayout>

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_marginTop="3dp"
        android:layout_height="38dp"
        android:paddingHorizontal="8dp"
        android:autofillHints="url"
        android:inputType="textUri"
        android:hint="@string/url_example"
        android:textColorHint="#A69A94"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_chain"
        android:drawableTint="#BDB5B1"
        android:drawablePadding="8dp"
        android:textSize="14sp" />

    <!-- Nombre field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name_label"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mandatory_field"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#F44336" />

    </LinearLayout>

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="3dp"
        android:paddingHorizontal="8dp"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:hint="@string/name_example"
        android:textColorHint="#A69A94"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_person"
        android:drawableTint="#BDB5B1"
        android:drawablePadding="8dp"
        android:textSize="14sp" />

    <!-- Correo field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mail_label"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mandatory_field"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#F44336" />

    </LinearLayout>

    <EditText
        android:id="@+id/mailInput"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="3dp"
        android:paddingHorizontal="8dp"
        android:autofillHints="emailAddress"
        android:inputType="textEmailAddress"
        android:hint="@string/mail_example"
        android:textColorHint="#A69A94"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_mail"
        android:drawableTint="#BDB5B1"
        android:drawablePadding="8dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/login_button"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="33dp"
        android:text="@string/connect_button"
        android:fontFamily="@font/manrope_extrabold"
        android:background="@drawable/ripple_button"
        app:backgroundTint="@null" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout >