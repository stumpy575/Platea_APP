<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="124dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="12dp"
    android:background="@drawable/bg_ticket_item">

    <!-- Imagen del evento -->
    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:padding="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:background="@drawable/bg_event_image"
        android:contentDescription="@string/show_img" />

    <!-- Información de la entrada -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cart_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Danza Contemporánea: Cuerpos en Movimiento" />

        <TextView
            android:id="@+id/cart_ticket_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Dempeus" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Precio unitario y controles para cambiar o quitar la entrada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cart_unit_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                tools:text="15.00€" />

            <!-- Selector de cantidad (solo entradas generales) -->
            <LinearLayout
                android:id="@+id/cart_quantity_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="3dp"
                android:background="@drawable/bg_quantity"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/cart_quantity_minus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_round_button_ripple"
                    android:src="@drawable/ic_remove"
                    android:contentDescription="@string/decrease_quantity"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/cart_quantity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="30dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:textColor="@color/text_primary"
                    tools:text="2" />

                <ImageButton
                    android:id="@+id/cart_quantity_plus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_round_button_ripple"
                    android:src="@drawable/ic_add"
                    android:contentDescription="@string/increase_quantity"
                    app:tint="@color/accent" />

            </LinearLayout>

            <!-- Papelera (solo entradas numeradas: una línea por butaca) -->
            <ImageButton
                android:id="@+id/cart_remove_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="7dp"
                android:background="@drawable/bg_round_button_ripple"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/remove_ticket"
                android:visibility="gone"
                app:tint="@color/error"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
