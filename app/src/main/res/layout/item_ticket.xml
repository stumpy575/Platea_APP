<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/bg_ticket_item">

    <!-- Nombre y precio -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ticket_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_variable"
            android:textStyle="bold"
            android:textColor="#212121"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="VIP Gold Experience" />

        <TextView
            android:id="@+id/ticket_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/accent"
            tools:text="59.90€" />

    </LinearLayout>

    <!-- Selector de cantidad -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="3dp"
        android:background="@drawable/bg_quantity">

        <ImageButton
            android:id="@+id/quantity_minus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="7dp"
            android:background="@drawable/bg_round_button_ripple"
            android:src="@drawable/ic_remove"
            android:contentDescription="@string/decrease_quantity"
            app:tint="#757575" />

        <TextView
            android:id="@+id/quantity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#212121"
            tools:text="0" />

        <ImageButton
            android:id="@+id/quantity_plus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="7dp"
            android:background="@drawable/bg_round_button_ripple"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/increase_quantity"
            app:tint="@color/accent" />

    </LinearLayout>

</LinearLayout>
