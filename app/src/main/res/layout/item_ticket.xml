<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/bg_ticket_item">

    <!-- Nombre y precio -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ticket_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_extrabold"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="VIP Gold Experience" />

            <TextView
                android:id="@+id/ticket_selected_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_selected_label"
                android:textSize="10sp"
                android:fontFamily="@font/manrope_extrabold"
                android:textColor="@color/accent"
                android:visibility="gone"
                tools:text="2 selec."
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ticket_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_extrabold"
                android:textColor="@color/accent"
                tools:text="59.90€" />

            <TextView
                android:id="@+id/ticket_zone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:fontFamily="@font/manrope_extrabold"
                android:textColor="@color/text_muted"
                tools:text="Z2" />

        </LinearLayout>

        <TextView
            android:id="@+id/ticket_selected_seats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@android:color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Butacas: F1-1, F2-3"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Selector de cantidad -->
    <LinearLayout
        android:id="@+id/quantity_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="3dp"
        android:background="@drawable/bg_quantity">

        <ImageButton
            android:id="@+id/quantity_minus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="7dp"
            android:background="@drawable/bg_round_button_ripple"
            android:src="@drawable/ic_remove"
            android:contentDescription="@string/decrease_quantity"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/quantity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:gravity="center"
            android:textSize="16sp"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="@color/text_primary"
            tools:text="0" />

        <ImageButton
            android:id="@+id/quantity_plus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="7dp"
            android:background="@drawable/bg_round_button_ripple"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/increase_quantity"
            app:tint="@color/accent" />

    </LinearLayout>

    <!-- Botón de selección de asiento (solo zonas numeradas) -->
    <TextView
        android:id="@+id/select_seat_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:text="@string/select_seat"
        android:textSize="13sp"
        android:fontFamily="@font/manrope_extrabold"
        android:textColor="@color/white"
        android:background="@drawable/ripple_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
